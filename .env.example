# Vùng đất Tinh linh — Cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env)

# Cấu hình Supabase (Lấy tại: Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server nên dùng service_role key (giữ bí mật), hoặc anon key nếu đã bật RLS
SUPABASE_KEY=your-supabase-key

# Cổng server chạy (mặc định 2567)
PORT=2567

# Thư mục lưu file dự phòng offline (mặc định ./data)
DATA_DIR=./data

# Khoá ký phiên đăng nhập nhanh (chuỗi ngẫu nhiên ≥ 16 ký tự, giữ bí mật).
# Để trống: server tự tạo và lưu vào DATA_DIR/auth-secret.txt. Đổi khoá = mọi người phải đăng nhập lại.
AUTH_SECRET=

# Domain client được gọi API đăng nhập khi client deploy riêng (ví dụ https://ten-game.vercel.app). Mặc định: *
CORS_ORIGIN=

# Token Cloudflare named tunnel (tuỳ chọn nếu dùng Cloudflare Tunnel)
TUNNEL_TOKEN=
