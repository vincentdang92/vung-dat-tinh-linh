# Happy Land — Cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env)

# Cấu hình Supabase (Lấy tại: Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Server nên dùng service_role key (giữ bí mật), hoặc anon key nếu đã bật RLS
SUPABASE_KEY=your-supabase-key

# Cổng server chạy (mặc định 2567)
PORT=2567

# Thư mục lưu file dự phòng offline (mặc định ./data)
DATA_DIR=./data

# Token Cloudflare named tunnel (tuỳ chọn nếu dùng Cloudflare Tunnel)
TUNNEL_TOKEN=
